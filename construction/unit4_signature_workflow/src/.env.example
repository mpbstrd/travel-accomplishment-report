# Application Configuration
NODE_ENV=development
PORT=3004

# JWT Configuration
# PRODUCTION NOTE: Use a strong, randomly generated secret (minimum 32 characters)
# Store in secure key vault (Azure Key Vault, AWS Secrets Manager, etc.)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database Configuration - SQLite (File-based, no server required)
# PRODUCTION NOTE: For production, switch to PostgreSQL, MS SQL Server, or MySQL
# The database file will be created automatically in the data directory
DB_PATH=./data/signature_workflow.db

# PRODUCTION DATABASE CONFIGURATION (when migrating from SQLite):
# Uncomment and configure for your production database
# DB_TYPE=postgres  # or mssql, mysql, mariadb
# DB_HOST=your-db-server.com
# DB_PORT=5432  # 5432 for postgres, 1433 for mssql, 3306 for mysql
# DB_NAME=signature_workflow_db
# DB_USER=your_username
# DB_PASSWORD=your_secure_password
# DB_SSL=true  # Enable SSL for production
# DB_POOL_MIN=5
# DB_POOL_MAX=50

# Logging Configuration
# PRODUCTION NOTE: Set to 'error' or 'warn' in production to reduce log volume
LOG_LEVEL=debug

# Mock Services Configuration
# Set to 'true' to use mock implementations for local testing without external services
# Set to 'false' to use real service integrations
USE_MOCK_SERVICES=true

# External Service URLs (Mock for local development)
# PRODUCTION NOTE: Update these to actual service endpoints in production
USER_MGMT_URL=http://localhost:3001/api
REPORT_MGMT_URL=http://localhost:3002/api
NOTIFICATION_URL=http://localhost:3005/api

# CORS Configuration
# PRODUCTION NOTE: Set to specific frontend domain(s) in production
# Example: CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=*

# Rate Limiting
# PRODUCTION NOTE: Adjust based on expected traffic patterns
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
