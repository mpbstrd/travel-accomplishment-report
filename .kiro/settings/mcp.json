{
  "mcpServers": {
    "filesystem": {
      "command": "uvx",
      "args": [
        "mcp-server-filesystem@latest",
        "."
      ],
      "disabled": true,
      "autoApprove": []
    },
    "fetch": {
      "command": "C:\\Users\\mpbbustarde\\.local\\bin\\uvx.exe",
      "args": [
        "mcp-server-fetch@latest"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "UV_TIMEOUT": "120"
      },
      "disabled": false,
      "autoApprove": []
    },
    "document-loader": {
      "command": "C:\\Users\\mpbbustarde\\.local\\bin\\uvx.exe",
      "args": [
        "--python",
        "3.13",
        "awslabs.document-loader-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "PYTHONUNBUFFERED": "1"
      },
      "disabled": false,
      "autoApprove": [
        "read_document",
        "read_image"
      ]
    }
  }
}